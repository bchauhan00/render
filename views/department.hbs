<div class="row">
    <div class="col-md-12">

        <h2>{{department.departmentName}} - Department: {{department.departmentId}}</h2>
        <hr />

        <form method="post" action="/department/update">

            <input type="hidden" name="departmentId" value="{{department.departmentId}}" />

            <fieldset>
                <legend>Department Information</legend>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="departmentName" class="form-label">Department Name:</label>
                            <input class="form-control" id="departmentName" name="departmentName" type="text" value="{{department.departmentName}}" />
                        </div>
                    </div>
                </div>
            </fieldset>

            <hr />

            <input type="submit" class="btn btn-primary float-end" value="Update Department" /><br /><br /><br />

        </form>
    </div>
</div>